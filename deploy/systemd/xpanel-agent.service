[Unit]
Description=X-Panel agent (privileged system operations)
After=network.target

[Service]
Type=simple
User=root
ExecStart=/opt/xpanel/bin/xpanel-agent -socket /run/xpanel/agent.sock -group xpanel
RuntimeDirectory=xpanel
RuntimeDirectoryMode=0755
EnvironmentFile=-/etc/xpanel/agent.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
